[Unit]
Description=Raspberry Pi Camera RTSP Stream
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change this if your Raspberry Pi user is not admin.
User=admin
WorkingDirectory=/home/admin/mediamtx
Environment=CAMERA_MODE=2304:1296
Environment=CAMERA_FRAMERATE=30
Environment=CAMERA_INTRA=30
Environment=HIGH_BITRATE=4000000
ExecStart=/usr/local/bin/pi-camera-stream.sh
Restart=always
RestartSec=5

# Helpful for ffmpeg / camera pipelines
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
