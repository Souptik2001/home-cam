[Unit]
Description=Cloudflare Tunnel connector for Souptik services
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/home/bob-home/.local/bin/cloudflared tunnel --no-autoupdate run --token-file /home/bob-home/.config/cloudflared/tunnel-token
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/bob-home/.config/cloudflared/tunnel-token
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=default.target
