# Copy to .env and replace every placeholder before use.
POSTGRES_DB=amader_home_assistant
POSTGRES_USER=amader_home_assistant
POSTGRES_PASSWORD=replace-with-a-long-random-password
PAIRING_CODE=replace-with-a-long-random-one-time-code
DOORBELL_HMAC_SECRETS={"front-door":"replace-with-a-long-random-shared-secret"}
ALLOWED_ORIGINS=[]
HMAC_MAX_AGE_SECONDS=300
MAX_INGEST_BODY_BYTES=16384
PAIRING_ATTEMPTS_PER_MINUTE=5
PAIRING_RATE_LIMIT_MAX_CLIENTS=2048
TRUSTED_PROXY_NETWORKS=[]
CAMERA_BASE_URL=https://camera.souptik.dev
WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-url-safe-vapid-public-key
WEB_PUSH_VAPID_PRIVATE_KEY_FILE=/home/bob-home/.config/amader-home-assistant/vapid/private_key.pem
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_ALLOWED_HOSTS=["web.push.apple.com","fcm.googleapis.com"]
WEB_PUSH_TIMEOUT_SECONDS=5
IOS_CRITICAL_ALERTS_ENABLED=false
API_BIND_ADDRESS=127.0.0.1
API_PORT=8787
