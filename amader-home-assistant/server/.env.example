DATABASE_URL=sqlite:///./data/amader-home-assistant.db
PAIRING_CODE=replace-with-a-long-random-one-time-code
DOORBELL_HMAC_SECRETS={"front-door":"replace-with-a-long-random-shared-secret"}
ALLOWED_ORIGINS=[]
HMAC_MAX_AGE_SECONDS=300
MAX_INGEST_BODY_BYTES=16384
PAIRING_ATTEMPTS_PER_MINUTE=5
PAIRING_RATE_LIMIT_MAX_CLIENTS=2048
TRUSTED_PROXY_NETWORKS=[]
CAMERA_BASE_URL=https://camera.souptik.dev/#pi_cam_2

# Required for standards-based Web Push to the installed PWA.
WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-url-safe-vapid-public-key
WEB_PUSH_VAPID_PRIVATE_KEY_PATH=/home/bob-home/.config/amader-home-assistant/vapid/private_key.pem
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_ALLOWED_HOSTS=["web.push.apple.com","fcm.googleapis.com"]
WEB_PUSH_TIMEOUT_SECONDS=5

# Optional: configure one Firebase credential source for native Android push.
# FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
