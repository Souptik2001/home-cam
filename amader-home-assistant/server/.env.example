DATABASE_URL=sqlite:///./data/amader-home-assistant.db
PAIRING_CODE=replace-with-a-long-random-one-time-code
DOORBELL_HMAC_SECRETS={"front-door":"replace-with-a-long-random-shared-secret"}
ALLOWED_ORIGINS=["https://your-doorbell-app.example"]
HMAC_MAX_AGE_SECONDS=300
MAX_INGEST_BODY_BYTES=16384
CAMERA_BASE_URL=https://camera.souptik.dev
IOS_CRITICAL_ALERTS_ENABLED=false

# Configure one Firebase credential source to enable push delivery.
# FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
